{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4321",
      "startServerReadyPattern": "localhost:4321",
      "url": [
        "http://localhost:4321/blueteam-library/en/",
        "http://localhost:4321/blueteam-library/zh/rules/",
        "http://localhost:4321/blueteam-library/en/rules/btl_win_curl_download_to_staging_dir/",
        "http://localhost:4321/blueteam-library/zh/matrix/",
        "http://localhost:4321/blueteam-library/zh/incidents/cloudflare-thanksgiving-2023/"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--headless=new --no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
