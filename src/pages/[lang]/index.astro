---
import Base from "../../layouts/Base.astro";
import { langPaths, t, TACTIC_ORDER, tacticName, levelName, type Lang } from "../../i18n";
import { rules, incidents, ruleTitle, ruleSummary } from "../../data";
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const rs = await rules(), is = await incidents();
const techCount = new Set(rs.flatMap(r => r.data.techniques)).size;
const featured = rs.filter(r => r.data.featured);
const recent = rs.slice(0, 6);
const tac = TACTIC_ORDER.map(id => ({ id, n: rs.filter(r => r.data.tactics.includes(id)).length }))
  .sort((a, b) => b.n - a.n).slice(0, 7);
const max = tac[0].n || 1;
---
<Base lang={lang} nav="home">
  <div class="hero"><h1>{t(lang, "site")}</h1><p>{t(lang, "tagline")}</p></div>
  <div class="stats">
    <span><b>{rs.length}</b> {t(lang, "rulesCount")}</span>
    <span><b>{is.length}</b> {t(lang, "incidentsCount")}</span>
    <span><b>{techCount}</b> {t(lang, "techCount")}</span>
    <span>{t(lang, "sourceSynced")} <a href="https://github.com/SigmaHQ/sigma" rel="noopener" target="_blank">SigmaHQ</a></span>
  </div>
  <form class="search" action={`/${lang}/search/`}>
    <input name="q" placeholder={t(lang, "searchPh")} autocomplete="off" />
    <button class="btn">{t(lang, "search")}</button>
  </form>
  <div class="grid2">
    <div>
      <section class="panel">
        <div class="panel-head"><h2>{t(lang, "latestIncidents")}</h2><a class="small" href={`/${lang}/incidents/`}>{t(lang, "all")} →</a></div>
        <ol class="rank">
          {is.slice(0, 5).map((i, k) => (
            <li><span class="n">{k + 1}</span><div>
              <a class="t" href={`/${lang}/incidents/${i.id}/`}>{i.data.title[lang]}</a>
              <div class="s">{i.data.summary[lang]}</div>
              <div class="badges"><span class={`sev sev-${i.data.severity}`}>{levelName(lang, i.data.severity)}</span><span class="badge">{i.data.publisher}</span><span class="badge">{i.data.published}</span></div>
            </div></li>))}
        </ol>
      </section>
      <section class="panel">
        <div class="panel-head"><h2>{t(lang, "featured")}</h2><a class="small" href={`/${lang}/rules/`}>{t(lang, "all")} →</a></div>
        {featured.map(r => (
          <a class="card" href={`/${lang}/rules/${r.id}/`}>
            <button class="star" data-star={"r:" + r.id} aria-label="save">☆</button>
            <div class="row1"><span class={`sev sev-${r.data.level}`}>{levelName(lang, r.data.level)}</span><span class="badge fmt">Sigma</span>{r.data.tactics.slice(0, 2).map(x => <span class="badge">{tacticName(lang, x)}</span>)}</div>
            <div class="title" style="margin-top:6px">{ruleTitle(r, lang)}</div>
            <div class="sum">{ruleSummary(r, lang)}</div>
            <div class="meta"><span>{r.data.source.name}</span><span>{r.data.author}</span></div>
          </a>))}
      </section>
    </div>
    <div>
      <section class="panel">
        <div class="panel-head"><h2>{t(lang, "topTactics")}</h2><a class="small" href={`/${lang}/matrix/`}>{t(lang, "matrix")} →</a></div>
        {tac.map(x => (
          <a class="trend" href={`/${lang}/rules/?tactic=${x.id}`} style="color:inherit">
            <span>{tacticName(lang, x.id)} <span class="muted small">{x.id}</span></span><span class="small muted">{x.n}</span>
            <span class="bar"><i style={`width:${(x.n / max) * 100}%`}></i></span></a>))}
      </section>
      <section class="panel">
        <div class="panel-head"><h2>{t(lang, "recentRules")}</h2></div>
        <ol class="rank">
          {recent.map(r => (
            <li style="grid-template-columns:1fr"><div><a class="t" href={`/${lang}/rules/${r.id}/`}>{ruleTitle(r, lang)}</a>
              <div class="badges"><span class={`sev sev-${r.data.level}`}>{levelName(lang, r.data.level)}</span><span class="badge">{r.data.modified || r.data.date}</span></div></div></li>))}
        </ol>
      </section>
    </div>
  </div>
</Base>
