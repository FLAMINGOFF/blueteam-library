---
import Base from "../../layouts/Base.astro";
import { langPaths, t, TACTIC_ORDER, tacticName, levelName, type Lang, B } from "../../i18n";
import { rules, incidents, ruleTitle, ruleSummary } from "../../data";
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const rs = await rules(), is = await incidents();
const techCount = new Set(rs.flatMap(r => r.data.techniques)).size;
const featured = rs.filter(r => r.data.featured);
const originals = rs.filter(r => r.data.original).sort((a, b) => a.id.localeCompare(b.id));
const recent = rs.slice(0, 6);
const tac = TACTIC_ORDER.map(id => ({ id, n: rs.filter(r => r.data.tactics.includes(id)).length }))
  .sort((a, b) => b.n - a.n).slice(0, 7);
const max = tac[0].n || 1;
---
<Base lang={lang} nav="home">
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-inner">
      <span class="eyebrow"><span class="pulse"></span>{lang === "zh" ? "开放 · 可追溯 · 按 ATT&CK 组织" : "Open · Attributed · Mapped to ATT&CK"}</span>
      <h1>{t(lang, "site")}</h1>
      <p class="lead">{t(lang, "tagline")}</p>
      <form class="search search-hero" action={`${B}/${lang}/search/`} role="search">
        <svg class="search-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input name="q" type="search" aria-label={t(lang, "search")} placeholder={t(lang, "searchPh")} autocomplete="off" />
        <kbd>/</kbd>
        <button class="btn">{t(lang, "search")}</button>
      </form>
      <div class="stat-tiles">
        <a class="tile" href={`${B}/${lang}/rules/`}><b>{rs.length.toLocaleString()}</b><span>{t(lang, "rulesCount")}</span></a>
        <a class="tile" href={`${B}/${lang}/incidents/`}><b>{is.length}</b><span>{t(lang, "incidentsCount")}</span></a>
        <a class="tile" href={`${B}/${lang}/matrix/`}><b>{techCount}</b><span>{t(lang, "techCount")}</span></a>
        <a class="tile" href="https://github.com/SigmaHQ/sigma" rel="noopener" target="_blank"><b>SigmaHQ</b><span>{t(lang, "sourceSynced")}</span></a>
      </div>
    </div>
  </section>
  <section class="obs" id="obs" data-base={B} data-lang={lang}>
    <header class="obs-head">
      <b class="obs-title">{lang === "zh" ? "检测观测台" : "Detection Observatory"}</b>
      <ol class="obs-steps">
        <li><span>01</span>{lang === "zh" ? "规则更新流" : "Rule stream"}</li>
        <li><span>02</span>{lang === "zh" ? "立体星图" : "3D star map"}</li>
        <li><span>03</span>{lang === "zh" ? "战术频谱" : "Tactic spectrum"}</li>
      </ol>
      <button class="obs-pause" type="button" data-pause aria-pressed="false"><span class="dot"></span><span class="lbl">{lang === "zh" ? "暂停动效" : "Pause motion"}</span></button>
    </header>
    <div class="obs-body">
      <div class="obs-stream">
        <div class="obs-sub"><span class="mono">01 /</span> {lang === "zh" ? "规则更新流" : "Rule stream"} <span class="muted mono">· SigmaHQ</span></div>
        <div class="stream-card" id="streamCard"></div>
        <ul class="stream-list" id="streamList"></ul>
      </div>
      <div class="obs-star">
        <div class="obs-sub"><span class="mono">02 /</span> {lang === "zh" ? "立体星图" : "3D star map"}<span class="muted obs-hint">{lang === "zh" ? "拖动旋转，点一颗星查看规则" : "Drag to rotate, click a star to open"}</span></div>
        <canvas id="starCanvas" aria-label={lang === "zh" ? "按 ATT&CK 战术分布的检测规则星图" : "Star map of detection rules by ATT&CK tactic"} role="img"></canvas>
        <div class="star-tip" id="starTip" hidden></div>
        <div class="star-legend" id="starLegend"></div>
      </div>
      <div class="obs-spec">
        <div class="obs-sub"><span class="mono">03 /</span> {lang === "zh" ? "战术频谱" : "Tactic spectrum"}<span class="muted obs-hint">{lang === "zh" ? "柱高为规则数，新规则汇入时跳动" : "Bar height = rule count; jumps on new rules"}</span></div>
        <canvas id="specCanvas" role="img" aria-label={lang === "zh" ? "各战术规则数量频谱" : "Rule count per tactic"}></canvas>
      </div>
    </div>
  </section>
  <script is:inline src={B + "/viz.js"} defer></script>
  <div class="grid2">
    <div>
      <section class="panel">
        <div class="panel-head"><h2>{t(lang, "latestIncidents")}</h2><a class="small" href={`${B}/${lang}/incidents/`}>{t(lang, "all")} →</a></div>
        <ol class="rank">
          {is.slice(0, 5).map((i, k) => (
            <li><span class="n">{k + 1}</span><div>
              <a class="t" href={`${B}/${lang}/incidents/${i.id}/`}>{i.data.title[lang]}</a>
              <div class="s">{i.data.summary[lang]}</div>
              <div class="badges"><span class={`sev sev-${i.data.severity}`}>{levelName(lang, i.data.severity)}</span><span class="badge">{i.data.publisher}</span><span class="badge">{i.data.published}</span></div>
            </div></li>))}
        </ol>
      </section>
      <section class="panel" id="original">
        <div class="panel-head"><h2>{t(lang, "originalRules")}</h2><a class="small" href={`${B}/${lang}/rules/?source=Blue+Team+Library`}>{t(lang, "all")} →</a></div>
        <p class="muted small" style="margin-top:0">{t(lang, "originalIntro")}</p>
        {originals.map(r => (
          <article class="card">
            <button class="star" type="button" data-star={"r:" + r.id} aria-pressed="false" aria-label={`${t(lang, "save")}: ${ruleTitle(r, lang)}`}>☆</button>
            <div class="row1"><span class="badge og">{t(lang, "original")}</span><span class={`sev sev-${r.data.level}`}>{levelName(lang, r.data.level)}</span><span class="badge">{r.data.platform}</span>{r.data.tactics.slice(0, 2).map(x => <span class="badge">{tacticName(lang, x)}</span>)}</div>
            <a class="title" style="margin-top:6px" href={`${B}/${lang}/rules/${r.id}/`}>{ruleTitle(r, lang)}</a>
            <div class="sum">{ruleSummary(r, lang)}</div>
            <div class="meta"><span>{r.data.techniques.join(", ")}</span><span>{(r.data.samples || []).length} {lang === "zh" ? "条样例日志" : "sample logs"}</span></div>
          </article>))}
      </section>
      <section class="panel">
        <div class="panel-head"><h2>{t(lang, "featured")}</h2><a class="small" href={`${B}/${lang}/rules/`}>{t(lang, "all")} →</a></div>
        {featured.map(r => (
          <article class="card">
            <button class="star" type="button" data-star={"r:" + r.id} aria-pressed="false" aria-label={`${t(lang, "save")}: ${ruleTitle(r, lang)}`}>☆</button>
            <div class="row1"><span class={`sev sev-${r.data.level}`}>{levelName(lang, r.data.level)}</span><span class="badge fmt">Sigma</span>{r.data.tactics.slice(0, 2).map(x => <span class="badge">{tacticName(lang, x)}</span>)}</div>
            <a class="title" style="margin-top:6px" href={`${B}/${lang}/rules/${r.id}/`}>{ruleTitle(r, lang)}</a>
            <div class="sum">{ruleSummary(r, lang)}</div>
            <div class="meta"><span>{r.data.source.name}</span><span>{r.data.author}</span></div>
          </article>))}
      </section>
    </div>
    <div>
      <section class="panel">
        <div class="panel-head"><h2>{t(lang, "topTactics")}</h2><a class="small" href={`${B}/${lang}/matrix/`}>{t(lang, "matrix")} →</a></div>
        {tac.map(x => (
          <a class="trend" href={`${B}/${lang}/rules/?tactic=${x.id}`} style="color:inherit">
            <span>{tacticName(lang, x.id)} <span class="muted small">{x.id}</span></span><span class="small muted">{x.n}</span>
            <span class="bar"><i style={`width:${(x.n / max) * 100}%`}></i></span></a>))}
      </section>
      <section class="panel">
        <div class="panel-head"><h2>{t(lang, "recentRules")}</h2></div>
        <ol class="rank">
          {recent.map(r => (
            <li style="grid-template-columns:1fr"><div><a class="t" href={`${B}/${lang}/rules/${r.id}/`}>{ruleTitle(r, lang)}</a>
              <div class="badges"><span class={`sev sev-${r.data.level}`}>{levelName(lang, r.data.level)}</span><span class="badge">{r.data.modified || r.data.date}</span></div></div></li>))}
        </ol>
      </section>
    </div>
  </div>
</Base>
